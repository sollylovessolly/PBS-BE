DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PORT=4000

# Use a Paystack test secret while the business account is not live.
# Switching to sk_live_ after activation requires only an environment change.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

# Optional until the Shipbubble account/API access is configured. Use sb_sandbox_ first.
SHIPBUBBLE_API_KEY=sb_sandbox_replace_me
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1
SHIPBUBBLE_SENDER_ADDRESS_CODE=123456
SHIPBUBBLE_CATEGORY_ID=123456
SHIPBUBBLE_DEFAULT_UNIT_WEIGHT_KG=0.1
SHIPBUBBLE_PACKAGE_LENGTH_CM=25
SHIPBUBBLE_PACKAGE_WIDTH_CM=20
SHIPBUBBLE_PACKAGE_HEIGHT_CM=8
SHIPPING_RATE_LIMIT_PER_MINUTE=20

# Supabase Storage service credentials stay server-side. Keep the bucket private;
# durable downloads are proxied through unguessable backend file URLs.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=production-files

# Vercel uses private Neon Object Storage. Supabase values above are needed
# only while copying legacy files. Never put these credentials in the frontend.
STORAGE_PROVIDER=supabase
AWS_ENDPOINT_URL_S3=https://BRANCH.storage.CLUSTER.us-east-1.aws.neon.tech
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
NEON_STORAGE_BUCKET=production-files
CRON_SECRET=replace_with_at_least_32_random_characters
ADDITIONAL_FRONTEND_ORIGINS=

# Gallery/review media
GALLERY_UPLOAD_RATE_LIMIT_PER_MINUTE=20
REVIEW_SUBMISSION_RATE_LIMIT_PER_MINUTE=5
GALLERY_ORPHAN_CLEANUP_INTERVAL_MS=3600000
MAX_IMAGE_UPLOAD_BYTES=15000000
MAX_PREVIEW_UPLOAD_BYTES=2000000
MAX_PDF_UPLOAD_BYTES=20000000
PUBLIC_API_URL=http://localhost:4000

ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Owner
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN_SECONDS=3600

# Comma-separated browser origins. Production should contain only deployed apps.
ADMIN_FRONTEND_URL=http://localhost:3001
JSON_BODY_LIMIT=1mb
LOGIN_RATE_LIMIT_PER_MINUTE=5
TRACKING_RATE_LIMIT_PER_MINUTE=30
ORDER_RATE_LIMIT_PER_MINUTE=10
PAYMENT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Optional notifications. Missing credentials disable that channel safely.
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
WHATSAPP_OWNER_PHONE=2348012345678
WHATSAPP_API_VERSION=v21.0
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_me
EMAIL_FROM=PolaroidsBySolly <orders@example.com>
OWNER_NOTIFICATION_EMAIL=owner@example.com
DISCORD_WEBHOOK_URL=replace_me
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_OWNER_CHAT_ID=replace_me
TERMII_API_KEY=replace_me
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Polaroids
TERMII_CHANNEL=generic
SMS_OWNER_PHONE=2348012345678
