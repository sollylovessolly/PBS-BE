generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ApiRateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model DeliveryRate {
  id              String   @id @default(cuid())
  state           String
  normalizedState String   @unique
  fee             Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DiscountCode {
  id                 String       @id @default(cuid())
  code               String       @unique
  type               DiscountType
  value              Decimal      @db.Decimal(12, 2)
  isActive           Boolean      @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  minimumOrderAmount Decimal?     @db.Decimal(12, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Admin {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  passwordHash         String
  name                 String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  galleryAlbumsCreated GalleryAlbum[]         @relation("GalleryCreatedBy")
  galleryAlbumsUpdated GalleryAlbum[]         @relation("GalleryUpdatedBy")
  galleryUploads       GalleryPhoto[]
  galleryAudits        GalleryAudit[]
  reviewModerations    ReviewAudit[]
  contentDeletions     ContentDeletionAudit[]
}

model GalleryAlbum {
  id                  String             @id @default(cuid())
  slug                String             @unique
  title               String
  description         String             @default("")
  status              GalleryAlbumStatus @default(DRAFT)
  version             Int                @default(1)
  permissionConfirmed Boolean            @default(false)
  permissionActorId   String?
  permissionAt        DateTime?
  coverPhotoId        String?            @unique
  createRequestKey    String?
  createFingerprint   String?
  createdById         String
  updatedById         String
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdBy           Admin              @relation("GalleryCreatedBy", fields: [createdById], references: [id])
  updatedBy           Admin              @relation("GalleryUpdatedBy", fields: [updatedById], references: [id])
  photos              GalleryPhoto[]     @relation("AlbumPhotos")
  coverPhoto          GalleryPhoto?      @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  audits              GalleryAudit[]

  @@unique([createdById, createRequestKey])
  @@index([status, publishedAt, id])
  @@index([createdAt, id])
}

model GalleryPhoto {
  id                 String        @id @default(cuid())
  albumId            String?
  uploaderId         String
  requestKey         String
  contentFingerprint String
  fullKey            String        @unique
  thumbnailKey       String        @unique
  mimeType           String
  byteSize           Int
  width              Int
  height             Int
  caption            String        @default("")
  alt                String        @default("")
  featured           Boolean       @default(false)
  sortOrder          Int?
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  album              GalleryAlbum? @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  coverFor           GalleryAlbum? @relation("AlbumCover")
  uploader           Admin         @relation(fields: [uploaderId], references: [id])

  @@unique([uploaderId, requestKey])
  @@unique([albumId, sortOrder])
  @@index([albumId, sortOrder, id])
  @@index([expiresAt])
}

model GalleryAudit {
  id                  String              @id @default(cuid())
  albumId             String
  actorId             String
  action              String
  priorStatus         GalleryAlbumStatus?
  newStatus           GalleryAlbumStatus?
  permissionConfirmed Boolean?
  createdAt           DateTime            @default(now())
  album               GalleryAlbum        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  actor               Admin               @relation(fields: [actorId], references: [id])

  @@index([albumId, createdAt])
}

model Review {
  id                    String        @id @default(cuid())
  displayName           String
  rating                Int
  text                  String
  phone                 String
  orderNumber           String?
  status                ReviewStatus  @default(PENDING)
  verifiedPurchase      Boolean       @default(false)
  publicationConsent    Boolean
  consentVersion        String
  consentedAt           DateTime
  version               Int           @default(1)
  moderationReason      String?
  moderatedById         String?
  moderatedAt           DateTime?
  requestKey            String        @unique
  submissionFingerprint String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  photos                ReviewPhoto[]
  audits                ReviewAudit[]

  @@index([status, createdAt, id])
  @@index([phone])
}

model ReviewPhoto {
  id           String   @id @default(cuid())
  reviewId     String
  fullKey      String   @unique
  thumbnailKey String   @unique
  mimeType     String
  byteSize     Int
  width        Int
  height       Int
  sortOrder    Int
  createdAt    DateTime @default(now())
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, sortOrder])
  @@index([reviewId, sortOrder])
}

model ReviewAudit {
  id          String       @id @default(cuid())
  reviewId    String
  actorId     String
  priorStatus ReviewStatus
  newStatus   ReviewStatus
  reason      String?
  createdAt   DateTime     @default(now())
  review      Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor       Admin        @relation(fields: [actorId], references: [id])

  @@index([reviewId, createdAt])
}

model StorageCleanupJob {
  id            String   @id @default(cuid())
  objectKey     String   @unique
  purpose       String
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt, createdAt])
}

model ContentDeletionAudit {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  actorId    String
  createdAt  DateTime @default(now())
  actor      Admin    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([phone])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  category    ProductCategory
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id                 String                @id @default(cuid())
  name               String
  sku                String                @unique
  productId          String
  /// *
  /// * Examples:
  /// * Polaroid → Standard
  /// * Phone Case → iPhone 15 Pro
  /// * Vintage Letter → Normal Edge
  /// * Vintage Letter → Burnt Edge
  sellingPrice       Decimal               @db.Decimal(12, 2)
  /// *
  /// * Used mainly for phone cases.
  /// * Printable products can remain available while physical phone-case
  /// * variants depend on inventory.
  tracksStock        Boolean               @default(false)
  isActive           Boolean               @default(true)
  /// *
  /// * Cost paid to an outside vendor per item.
  /// * Photostrips and vintage letters can use this.
  outsourcedUnitCost Decimal               @default(0) @db.Decimal(12, 2)
  supplierId         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  orderItems         OrderItem[]
  resourceRules      ProductResourceRule[]
  product            Product               @relation(fields: [productId], references: [id])
  supplier           Supplier?             @relation("OutsourceSupplier", fields: [supplierId], references: [id])

  @@index([productId])
}

model Order {
  id                    String               @id @default(cuid())
  trackingToken         String?              @unique
  checkoutKey           String?              @unique
  checkoutToken         String?              @unique
  orderNumber           String               @unique
  customerId            String
  source                OrderSource
  status                OrderStatus          @default(PENDING)
  paymentStatus         PaymentStatus        @default(UNPAID)
  subtotal              Decimal              @db.Decimal(12, 2)
  deliveryFee           Decimal              @default(0) @db.Decimal(12, 2)
  discount              Decimal              @default(0) @db.Decimal(12, 2)
  discountCode          String?
  totalAmount           Decimal              @db.Decimal(12, 2)
  /// *
  /// * The customer's delivery fee and the actual courier cost
  /// * are stored separately.
  actualDeliveryCost    Decimal              @default(0) @db.Decimal(12, 2)
  deliveryState         String?
  deliveryAddress       String?
  trackingLink          String?
  customerNote          String?
  adminNote             String?
  /// *
  /// * Permanent cost and profit snapshots.
  /// * Old order profit will not change when future material prices change.
  revenueSnapshot       Decimal              @default(0) @db.Decimal(12, 2)
  materialCostSnapshot  Decimal              @default(0) @db.Decimal(12, 2)
  outsourceCostSnapshot Decimal              @default(0) @db.Decimal(12, 2)
  packagingCostSnapshot Decimal              @default(0) @db.Decimal(12, 2)
  deliveryCostSnapshot  Decimal              @default(0) @db.Decimal(12, 2)
  grossProfitSnapshot   Decimal              @default(0) @db.Decimal(12, 2)
  inventoryDeductedAt   DateTime?
  inventoryRestoredAt   DateTime?
  ownerNotifiedAt       DateTime?
  ownerEmailSentAt      DateTime?
  ownerTelegramSentAt   DateTime?
  ownerSmsSentAt        DateTime?
  ownerDiscordSentAt    DateTime?
  customerEmailSentAt   DateTime?
  shipmentRequestToken  String?
  shipmentServiceCode   String?
  shipmentCourierId     String?
  shipmentReference     String?              @unique
  shipmentStatus        String?
  shipmentError         String?
  shipmentAttemptedAt   DateTime?
  shipmentCreatedAt     DateTime?
  paidAt                DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  customer              Customer             @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  paymentAttempt        PaymentAttempt?
  stockMovements        ResourceMovement[]

  @@index([customerId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model PaymentAttempt {
  id               String   @id @default(cuid())
  orderId          String   @unique
  reference        String   @unique
  authorizationUrl String
  accessCode       String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingQuote {
  id             String   @id @default(cuid())
  requestToken   String   @unique
  checkoutHash   String
  courierChoices Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

model OrderItem {
  id                     String         @id @default(cuid())
  orderId                String
  variantId              String
  quantity               Int
  /// *
  /// * Price and cost are copied here when the order is placed.
  /// * This preserves historical accuracy.
  unitPriceSnapshot      Decimal        @db.Decimal(12, 2)
  totalPriceSnapshot     Decimal        @db.Decimal(12, 2)
  outsourcedCostSnapshot Decimal        @default(0) @db.Decimal(12, 2)
  materialCostSnapshot   Decimal        @default(0) @db.Decimal(12, 2)
  /// *
  /// * Finished fulfillment data only:
  /// * - Polaroid final/preview image URLs
  /// * - Photostrip final image URL
  /// * - Vintage Letter final PDF URL
  /// * - Phone-case package option
  customization          Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant                ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                     String        @id @default(cuid())
  orderId                String
  method                 PaymentMethod
  status                 PaymentStatus
  amount                 Decimal       @db.Decimal(12, 2)
  reference              String?       @unique
  paidAt                 DateTime?
  reconciliationRequired Boolean       @default(false)
  reconciliationReason   String?
  createdAt              DateTime      @default(now())
  order                  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Resource {
  id                String                @id @default(cuid())
  name              String
  sku               String                @unique
  category          ResourceCategory
  /// *
  /// * Inventory is stored using its smallest useful unit.
  /// * Film: SHEET
  /// * Mailer bags: PIECE
  /// * Stickers: PIECE
  /// * Phone cases: PIECE
  unit              String
  /// *
  /// * Cached balance for fast dashboard queries.
  /// * Every change must also create a ResourceMovement.
  currentStock      Decimal               @default(0) @db.Decimal(12, 2)
  averageUnitCost   Decimal               @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal               @default(0) @db.Decimal(12, 2)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  orderRules        OrderResourceRule[]
  productRules      ProductResourceRule[]
  purchaseItems     PurchaseItem[]
  movements         ResourceMovement[]
}

model ProductResourceRule {
  id         String          @id @default(cuid())
  variantId  String
  resourceId String
  rule       ConsumptionRule
  /// *
  /// * PER_UNIT:
  /// * 1 film sheet × each Polaroid.
  /// * CAPACITY:
  /// * 1 box per 20 Polaroids.
  /// * FIXED:
  /// * A fixed quantity once for that line item.
  quantity   Decimal         @default(1) @db.Decimal(12, 2)
  capacity   Int?
  /// *
  /// * Rules sharing a usageGroup are totalled together first.
  /// * Example:
  /// * Normal Polaroids and phone cases with Polaroids can both use:
  /// * usageGroup = "POLAROID_PRINT"
  /// * This allows one combined box calculation.
  usageGroup String?
  resource   Resource        @relation(fields: [resourceId], references: [id])
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([resourceId])
}

model OrderResourceRule {
  id         String   @id @default(cuid())
  resourceId String
  /// *
  /// * Examples applied once per paid order:
  /// * Mailer bag × 1
  /// * Thank-you card × 1
  /// * Sticker × 2
  quantity   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
}

model ResourceMovement {
  id         String         @id @default(cuid())
  resourceId String
  /// *
  /// * Positive numbers add stock.
  /// * Negative numbers deduct stock.
  quantity   Decimal        @db.Decimal(12, 2)
  unitCost   Decimal        @default(0) @db.Decimal(12, 2)
  reason     MovementReason
  note       String?
  orderId    String?
  purchaseId String?
  createdAt  DateTime       @default(now())
  order      Order?         @relation(fields: [orderId], references: [id])
  purchase   Purchase?      @relation(fields: [purchaseId], references: [id])
  resource   Resource       @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
  @@index([orderId])
  @@index([purchaseId])
}

model Supplier {
  id                 String           @id @default(cuid())
  name               String
  phone              String?
  email              String?
  note               String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  outsourcedVariants ProductVariant[] @relation("OutsourceSupplier")
  purchases          Purchase[]
}

model Purchase {
  id          String             @id @default(cuid())
  supplierId  String?
  totalCost   Decimal            @db.Decimal(12, 2)
  note        String?
  purchasedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]
  movements   ResourceMovement[]

  @@index([supplierId])
}

model PurchaseItem {
  id                   String   @id @default(cuid())
  purchaseId           String
  resourceId           String
  /// *
  /// * Example:
  /// * purchaseQuantity = 3 packs
  /// * unitsPerPurchaseUnit = 20 sheets
  /// * totalBaseUnits = 60 sheets
  purchaseQuantity     Decimal  @db.Decimal(12, 2)
  purchaseUnit         String
  unitsPerPurchaseUnit Decimal  @default(1) @db.Decimal(12, 2)
  totalBaseUnits       Decimal  @db.Decimal(12, 2)
  totalCost            Decimal  @db.Decimal(12, 2)
  unitCost             Decimal  @db.Decimal(12, 2)
  purchase             Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  resource             Resource @relation(fields: [resourceId], references: [id])

  @@index([purchaseId])
  @@index([resourceId])
}

model Expense {
  id             String          @id @default(cuid())
  title          String
  description    String?
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  /// *
  /// * Optional connection to an order when an expense belongs directly
  /// * to one customer's order.
  relatedOrderId String?
  expenseDate    DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category])
  @@index([expenseDate])
}

model OwnerWithdrawal {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  withdrawnAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

enum ProductCategory {
  POLAROID
  PHONE_CASE
  PHOTOSTRIP
  VINTAGE_LETTER
  ALBUM
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum GalleryAlbumStatus {
  DRAFT
  PUBLISHED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  MANUAL
}

enum OrderStatus {
  PENDING
  DESIGNING
  PRINTING
  PACKING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

enum PaymentMethod {
  PAYSTACK
  TRANSFER
  OPAY
}

enum ResourceCategory {
  MATERIAL
  PACKAGING
  CONSUMABLE
  FINISHED_GOOD
}

enum ConsumptionRule {
  PER_UNIT
  FIXED
  CAPACITY
}

enum MovementReason {
  PURCHASE
  ORDER_USAGE
  DAMAGE
  WASTE
  PERSONAL_USE
  MANUAL_ADJUSTMENT
  RETURN
}

enum ExpenseCategory {
  DATA
  HOSTING
  SALARY
  MARKETING
  DELIVERY
  UTILITIES
  EQUIPMENT
  MATERIAL_PURCHASE
  OUTSOURCING
  OTHER
}
